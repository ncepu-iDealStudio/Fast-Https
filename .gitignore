modules/core/server/build/*
modules/core/server/build/CMakeFiles/*
dist/*
dist_windows/*
logs/*.log
/*.log
out/*
*.out
fast-https.exe
# 只忽略仓库根目录的编译产物：不加前导 / 会连 build/packaging/logrotate/fast-https 一起忽略
/fast-https
fast-https.pid
# 本地 Agent 配置可含模型令牌，不入库
/agent.json
go.mod
go.sum
config/cert/*.pem
config/cert/*.key
# ACME 账户与证书缓存是运行期状态，只保留占位文件
config/cert/acme/*
!config/cert/acme/.keep
# 站点文件属于部署配置；随包的默认站点要跟着版本走
config/conf.d/*.json
!config/conf.d/default.json
# 本地工具数据
.codebuddy/
httpdoc/root/root.crt
httpdoc/root/root.key
httpdoc/theme/*
.idea/*
.vscode/*logs/*
*.log
*.exe
*.pid
tests/test_data/*