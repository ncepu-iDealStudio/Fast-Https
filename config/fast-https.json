{
  "log_root": "./logs",
  "security": {
    "host_check": "off",
    "headers": {
      "nosniff": true,
      "hsts": "",
      "x_frame_options": "",
      "referrer_policy": "",
      "content_security_policy": ""
    }
  },
  "waf": {
    "mode": "disabled"
  },
  "http": {
    "include": ["./config/conf.d"],
    "default_type": "application/octet-stream",
    "servers_limit": {
      "max_header_size": 4096,
      "max_body_size": 524288,
      "limit": 0,
      "burst": 0
    },
    "blaklist": [],
    "log_format": ["ip_port", "time", "type", "method", "path", "host", "status", "size", "user_agent"]
  },
  "acme": {
    "enabled": false,
    "email": "<EMAIL>"
  }
}
