{
  "http": {
    "server": [
      {
        "listen": 80,
        "server_name": "localhost",
        "location": [
          {
            "url": "/",
            "type": "local",
            "root": "./httpdoc/root",
            "index": ["index.html", "index.htm"]
          }
        ]
      },
      {
        "listen": "443 ssl h2",
        "server_name": "localhost",
        "ssl_certificate": "./config/cert/localhost.pem",
        "ssl_certificate_key": "./config/cert/localhost-key.pem",
        "location": [
          {
            "url": "/",
            "type": "local",
            "root": "./httpdoc/root",
            "index": ["index.html", "index.htm"]
          }
        ]
      }
    ],
    "include": ["./config/conf.d"]
  },
  "acme": {
    "enabled": false,
    "email": "<EMAIL>"
  }
}
