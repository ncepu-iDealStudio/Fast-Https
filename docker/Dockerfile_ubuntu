FROM golang:1.27-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go env -w GOPROXY=https://goproxy.cn,direct

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o fast-https .

FROM ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /usr/local/fast-https/config/cert \
    /usr/local/fast-https/config/conf.d \
    /usr/local/fast-https/logs \
    /usr/local/fast-https/httpdoc/root

WORKDIR /usr/local/fast-https

COPY --from=builder /app/fast-https .
COPY config/fast-https.json config/mime.json config/fastcgi.conf ./config/
COPY httpdoc/root/index.html httpdoc/root/favicon.ico ./httpdoc/root/

ENV Fast-Https_VERSION=1.3.2
ENV FASTHTTPS_FOREGROUND=1
ENV PATH=$PATH:/usr/local/fast-https

EXPOSE 8080 443

CMD ["./fast-https"]
