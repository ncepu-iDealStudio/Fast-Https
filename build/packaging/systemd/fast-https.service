[Unit]
Description=Fast-Https web server and reverse proxy
Documentation=https://gitee.com/ncepu-bj/fast-https
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# -tags=rpm 编译的二进制把配置定位到 /etc/fast-https、站点到 /usr/share/fast-https、
# 日志到 /var/log/fast-https、pid 到 /run/fast-https、状态目录到 /var/lib/fast-https。
# 工作目录保留是为了配置文件里偶尔出现的相对路径仍能解析，它指向只读目录，不影响写入。
WorkingDirectory=/usr/share/fast-https
Environment=FASTHTTPS_FOREGROUND=1
ExecStart=/usr/bin/fast-https start
ExecReload=/usr/bin/fast-https reload
Restart=on-failure
RestartSec=2s
LimitNOFILE=65535
# 由 systemd 在启动前建目录并设属主/权限，不依赖 postinstall：
# /etc/fast-https 只在缺失时创建，不覆盖已有配置。
ConfigurationDirectory=fast-https
LogsDirectory=fast-https
StateDirectory=fast-https
StateDirectoryMode=0700
# /run/fast-https 在服务停止时由 systemd 清理。
RuntimeDirectory=fast-https

[Install]
WantedBy=multi-user.target
