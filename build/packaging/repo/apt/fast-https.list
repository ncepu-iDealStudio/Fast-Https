# Fast-Https APT 源（Debian / Ubuntu）
#
# 安装：
#   sudo install -d -m 0755 /etc/apt/keyrings
#   curl -fsSL @BASE_URL@/fast-https.gpg | sudo tee /etc/apt/keyrings/fast-https.gpg >/dev/null
#   sudo cp fast-https.list /etc/apt/sources.list.d/fast-https.list
#   sudo apt update && sudo apt install fast-https
#
# 仓库未签名时（生成脚本没给 GPG_KEY_ID），把方括号里的 signed-by 换成 trusted=yes：
#   deb [trusted=yes] @BASE_URL@/apt stable main
deb@SIGNED_BY@ @BASE_URL@/apt stable main
